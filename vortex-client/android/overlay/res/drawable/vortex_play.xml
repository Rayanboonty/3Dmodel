<?xml version="1.0" encoding="utf-8"?>
<!-- The Launch button: an amber gradient pill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="#80FFB547" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <gradient android:angle="270" android:startColor="@color/vortex_accent_light" android:centerColor="@color/vortex_accent" android:endColor="@color/vortex_accent_deep" />
                    <stroke android:width="1dp" android:color="#B3FFE2AA" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
