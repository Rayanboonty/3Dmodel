{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vortex",
  "mainBinaryName": "vortex",
  "version": "0.3.0",
  "identifier": "dev.vortexclient.launcher",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vortex Client",
        "width": 1240,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#0c0a10"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https://launchercontent.mojang.com https://cdn.modrinth.com https://*.modrinth.com; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  }
}
