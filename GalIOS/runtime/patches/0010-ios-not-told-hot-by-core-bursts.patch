diff --git a/runtime/bridges/thermal/test_thermal.c b/runtime/bridges/thermal/test_thermal.c
index 7989ff4..98e40d1 100644
--- a/runtime/bridges/thermal/test_thermal.c
+++ b/runtime/bridges/thermal/test_thermal.c
@@ -89,20 +89,23 @@ static void test_rules(void)
   br_thermal_decide(&l, &r, &s, &prev);
   CHECK(prev.level == BR_THERMAL_MODERATE);
   // the SoC rule alone
-  r = raw_with(350, 955, 300);
+  r = raw_with(350, 1045, 300);                            // GalIOS: a core's burst (104.5 C) is not HEAVY
+  br_thermal_decide(&l, &r, &prev, &s);
+  CHECK(s.level == BR_THERMAL_NOMINAL);
+  r = raw_with(350, 1075, 300);
   br_thermal_decide(&l, &r, &prev, &s);
   CHECK(s.level == BR_THERMAL_HEAVY && s.reason == BR_THERMAL_BY_SOC && s.skin_level == BR_THERMAL_NOMINAL);
-  r = raw_with(350, 1055, 300);
+  r = raw_with(350, 1105, 300);
   br_thermal_decide(&l, &r, &s, &prev);
   CHECK(prev.level == BR_THERMAL_TRAPPING && prev.cap == 2);
-  r = raw_with(350, 1010, 300);
+  r = raw_with(350, 1060, 300);
   br_thermal_decide(&l, &r, &prev, &s);
-  CHECK(s.level == BR_THERMAL_TRAPPING);                   // held to 100 C
-  r = raw_with(350, 990, 300);
+  CHECK(s.level == BR_THERMAL_TRAPPING);                   // held to 105 C
+  r = raw_with(350, 1040, 300);
   br_thermal_decide(&l, &r, &s, &prev);
-  CHECK(prev.level == BR_THERMAL_HEAVY);                   // below 100, above 90
+  CHECK(prev.level == BR_THERMAL_HEAVY);                   // below 105, above 102
   // two rules at one level: both named
-  r = raw_with(445, 950, 300);
+  r = raw_with(445, 1075, 300);
   br_thermal_decide(&l, &r, &prev, &s);
   CHECK(s.level == BR_THERMAL_HEAVY && s.reason == (BR_THERMAL_BY_SKIN | BR_THERMAL_BY_SOC));
   // the battery
diff --git a/runtime/bridges/thermal/thermal.c b/runtime/bridges/thermal/thermal.c
index c68437d..fe0bbc0 100644
--- a/runtime/bridges/thermal/thermal.c
+++ b/runtime/bridges/thermal/thermal.c
@@ -29,7 +29,11 @@ void br_thermal_limits_default(br_thermal_limits *l)
   // The SoC: the X4's first trip is 90 C (cpufreq-cpu7), the GPU's 95 C, the cores pause at 108-110 C (the phone's
   // thermal zones). HEAVY at 95 C, TRAPPING at 105 C: the kernel acts first, iOS is told. Not lower: a boot's first minute
   // reaches 94.6 C on the cores for some seconds (the phone, 2026-11-12), and a step then would only slow the boot.
-  l->soc[0] = 950; l->soc[1] = 1050; l->soc_hyst = 50;
+  // GalIOS: HEAVY at 107 C, TRAPPING at 110 C. On the S25 Ultra the cores' bursts reach 100-104 C within seconds of any
+  // load (2026-11-14: 33 of 39 HEAVY in one session came from the SoC, case 34-40 C), and each HEAVY makes iOS slow
+  // itself and cap the brightness; the host's kernel throttles those bursts on its own. The case and the battery still
+  // say when the phone is hot; the SoC only when the cores near their pause (108-110 C).
+  l->soc[0] = 1070; l->soc[1] = 1100; l->soc_hyst = 50;
   // The cell: charging stops near 50 C on Samsung phones [inference]; HEAVY at 45 C, TRAPPING at 50 C.
   l->battery[0] = 450; l->battery[1] = 500; l->battery_hyst = 20;
 }
