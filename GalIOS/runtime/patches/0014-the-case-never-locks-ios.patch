 // The load line from fake /proc and battery files: two samples 30 s apart on an 8-CPU host.
diff --git a/runtime/bridges/thermal/thermal.c b/runtime/bridges/thermal/thermal.c
index fe0bbc0..96785a2 100644
--- a/runtime/bridges/thermal/thermal.c
+++ b/runtime/bridges/thermal/thermal.c
@@ -79,6 +79,11 @@ void br_thermal_decide(const br_thermal_limits *l, const br_thermal_raw *raw, co
   memset(&s, 0, sizeof s);
   s.raw = *raw;
   s.skin_level = rule(raw->skin, l->skin, skin_levels, 5, prev ? prev->skin_level : 0, l->skin_hyst);
+  // GalIOS: the case alone tops at HEAVY (iOS slows itself down). Its TRAPPING (46 C) and SLEEPING (50 C) were a guess,
+  // not Samsung's policy (Samsung's charger only limits current there), and TRAPPING is Apple's "critical": iOS locks
+  // itself behind "iPhone needs to cool down" (the owner's video, 2026-11-14 21:48). The battery (50 C) and the SoC
+  // (110 C) still say TRAPPING: those are real limits.
+  if (s.skin_level > BR_THERMAL_HEAVY) s.skin_level = BR_THERMAL_HEAVY;
   s.soc_level = rule(raw->soc, l->soc, two_levels, 2, prev ? prev->soc_level : 0, l->soc_hyst);
   s.battery_level = rule(raw->battery, l->battery, two_levels, 2, prev ? prev->battery_level : 0, l->battery_hyst);
   s.level = s.skin_level;
