diff --git a/runtime/bridges/thermal/test_thermal.c b/runtime/bridges/thermal/test_thermal.c
index 0c955b2..f848e57 100644
--- a/runtime/bridges/thermal/test_thermal.c
+++ b/runtime/bridges/thermal/test_thermal.c
@@ -397,6 +397,32 @@ static void test_hal(void)
   CHECK(raw.soc == BR_THERMAL_UNKNOWN && raw.skin == BR_THERMAL_UNKNOWN && raw.battery == BR_THERMAL_UNKNOWN);
 }
 
+// GalIOS: what iOS is told: the case tops at HEAVY, the SoC speaks from 107 C, the battery as it is
+static void test_galios_told(void)
+{
+  br_thermal_limits l;
+  br_thermal_limits_default(&l);
+  br_thermal_state s;
+  br_thermal_raw r = raw_with(505, 500, 300);              // the case at 50.5 C: the rules say SLEEPING, iOS hears HEAVY
+  br_thermal_decide(&l, &r, NULL, &s);
+  CHECK(s.level == BR_THERMAL_SLEEPING && br_thermal_level_for_guest(&s) == BR_THERMAL_HEAVY);
+  r = raw_with(350, 1045, 300);                            // a core's burst to 104.5 C: nothing told
+  br_thermal_decide(&l, &r, NULL, &s);
+  CHECK(br_thermal_level_for_guest(&s) == BR_THERMAL_NOMINAL);
+  r = raw_with(350, 1075, 300);
+  br_thermal_decide(&l, &r, NULL, &s);
+  CHECK(br_thermal_level_for_guest(&s) == BR_THERMAL_HEAVY);
+  r = raw_with(350, 1105, 300);
+  br_thermal_decide(&l, &r, NULL, &s);
+  CHECK(br_thermal_level_for_guest(&s) == BR_THERMAL_TRAPPING);
+  r = raw_with(350, 500, 505);                             // the cell at 50.5 C: a real limit, told
+  br_thermal_decide(&l, &r, NULL, &s);
+  CHECK(br_thermal_level_for_guest(&s) == BR_THERMAL_TRAPPING);
+  r = raw_with(400, 500, 300);                             // light stays light
+  br_thermal_decide(&l, &r, NULL, &s);
+  CHECK(br_thermal_level_for_guest(&s) == BR_THERMAL_LIGHT);
+}
+
 int main(void)
 {
   br_log_sink = quiet;
@@ -409,6 +435,7 @@ int main(void)
   test_worker();
   test_load();
   test_hal();
+  test_galios_told();
   char cmd[300];
   snprintf(cmd, sizeof cmd, "rm -rf %s", base);
   if (system(cmd)) fprintf(stderr, "could not remove %s\n", base);
