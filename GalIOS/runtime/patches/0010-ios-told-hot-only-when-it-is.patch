   return s->skin_level >= BR_THERMAL_SLEEPING || s->battery_level >= BR_THERMAL_TRAPPING ? BR_THERMAL_CAP_CRITICAL : 0;
 }
 
+unsigned br_thermal_level_for_guest(const br_thermal_state *s)
+{
+  unsigned level = s->skin_level > BR_THERMAL_HEAVY ? BR_THERMAL_HEAVY : s->skin_level;
+  unsigned soc = s->raw.soc == BR_THERMAL_UNKNOWN ? BR_THERMAL_NOMINAL : s->raw.soc >= 1100 ? BR_THERMAL_TRAPPING : s->raw.soc >= 1070 ? BR_THERMAL_HEAVY : BR_THERMAL_NOMINAL;
+  if (soc > level) level = soc;
+  if (s->battery_level > level) level = s->battery_level;
+  return level;
+}
