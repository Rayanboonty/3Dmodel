+// GalIOS: whether an identity /product property is one of the screen's (identity_screen_only keeps only these).
+bool xl_machine_screen_prop(const char *name);
+
 // The board xnuhost emulates: where its windows are (physical addresses inside /arm-io).
 #define XL_BOARD_ARMIO_BASE     0x1000ull
