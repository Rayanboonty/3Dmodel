       LOGI("GalIOS identity: %u /product properties from the iPhone's tree (oled-display %s, island-notch-location %s, display-corner-radius %s)",
            p ? p->nprops : 0, p && xl_adt_get(p, "oled-display") ? "yes" : "no",
            p && xl_adt_get(p, "island-notch-location") ? "yes" : "no", p && xl_adt_get(p, "display-corner-radius") ? "yes" : "no");
