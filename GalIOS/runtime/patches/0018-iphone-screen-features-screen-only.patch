diff --git a/runtime/loader/src/machine.c b/runtime/loader/src/machine.c
index 9928989..10d6feb 100644
--- a/runtime/loader/src/machine.c
+++ b/runtime/loader/src/machine.c
@@ -84,6 +84,21 @@ static bool product_dropped(const char *name)
   return false;
 }
 
+// GalIOS: the identity's screen properties, all that identity_screen_only takes from its /product: the Dynamic
+// Island, the OLED panel, its corner radius and the always-on display. Not the board's name, its GPU feature sets or
+// the rest: those made iOS take the iPhone's heaviest rendering paths and its own touch tables, on a phone that has
+// neither (iOS lagged and touch stopped).
+bool xl_machine_screen_prop(const char *name)
+{
+  static const char *const exact[] = { "oled-display", "display-corner-radius", "supports-burnin-mitigation" };
+  static const char *const within[] = { "island", "always-on", "aod", "burn-in", "burnin", "notch" };
+  for (unsigned i = 0; i < sizeof exact / sizeof *exact; i++)
+    if (!strcmp(name, exact[i])) return true;
+  for (unsigned i = 0; i < sizeof within / sizeof *within; i++)
+    if (strstr(name, within[i])) return true;
+  return false;
+}
+
 // graphics-featureset-fallbacks without APPLE2 and MTL2,2 (a NUL-terminated, colon-separated list):
 // with them MobileGestalt answers DeviceSupportsASTC and SplashBoard writes app snapshots in the AGX
 // GPU's own ASTC layout, which no other GPU decodes.
@@ -137,13 +152,15 @@ xl_adt_node *xl_machine_tree(const xl_machine *m, const char **error)
   if (m->panic_size && ((m->panic_base | m->panic_size) & 0x3fff)) FAIL("the panic region must be 16 KiB aligned");
 
   const xl_adt_node *id = m->identity, *id_product = id ? xl_adt_child(id, "product") : NULL;
-  if (id && (!id_product || !xl_adt_get(id, "model") || !xl_adt_get(id, "target-type")))
+  if (id && m->identity_screen_only && !id_product)
+    { *error = "the identity tree has no /product"; return NULL; }
+  if (id && !m->identity_screen_only && (!id_product || !xl_adt_get(id, "model") || !xl_adt_get(id, "target-type")))
     { *error = "the identity tree has no model, target-type or /product"; return NULL; }
 
   root = xl_adt_new("device-tree");
   char compatible[160];
   size_t used = 0;
-  if (id) {
+  if (id && !m->identity_screen_only) {
     const xl_adt_prop *p = xl_adt_get(id, "model");
     xl_adt_set(root, "model", p->value, p->length);
     p = xl_adt_get(id, "target-type");
@@ -293,7 +310,7 @@ xl_adt_node *xl_machine_tree(const xl_machine *m, const char **error)
   xl_adt_set_u32(buttons, "home-button-type", 2);
 
   xl_adt_node *product = xl_adt_add(root, "product");
-  if (id_product) {
+  if (id_product && !m->identity_screen_only) {
     for (unsigned i = 0; i < id_product->nprops; i++) {
       const xl_adt_prop *p = &id_product->props[i];
       if (product_dropped(p->name)) continue;
@@ -308,6 +325,11 @@ xl_adt_node *xl_machine_tree(const xl_machine *m, const char **error)
     if (acoustic) xl_adt_set(audio, "acoustic-id", acoustic->value, acoustic->length);
   } else {
     xl_adt_set_str(product, "product-name", "OneiOS guest");
+    // GalIOS: screen only: the guest's own product, with the iPhone's screen properties added
+    if (id_product)
+      for (unsigned i = 0; i < id_product->nprops; i++)
+        if (xl_machine_screen_prop(id_product->props[i].name))
+          xl_adt_set(product, id_product->props[i].name, id_product->props[i].value, id_product->props[i].length);
   }
   // The artwork scale follows the UI scale (the identity tree's is the iPhone panel's 3). The artwork subtype
   // stays the identity's (2868 for iPhone18,2): it names a set of assets, and no set exists for another height.
