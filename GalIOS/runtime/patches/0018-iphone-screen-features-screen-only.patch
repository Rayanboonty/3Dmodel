+    CHECK(!strcmp((const char *)xl_adt_get(pr, "product-name")->value, "OneiOS guest"));
+    CHECK(strcmp((const char *)xl_adt_get(t, "model")->value, "Fixture1,1") != 0);   // the board stays the guest's
+    p = xl_adt_get(t, "compatible");
+    CHECK(p && memcmp(p->value, "F1AP", 4) != 0);
+    CHECK(xl_adt_get(t, "target-type") == NULL);
+    xl_adt_free(t);
+  }
+  CHECK(xl_machine_screen_prop("island-notch-location") && xl_machine_screen_prop("oled-display"));
+  CHECK(!xl_machine_screen_prop("graphics-featureset-class") && !xl_machine_screen_prop("compatible-device-fallback"));
+  m.identity_screen_only = false;
   xl_adt_remove(donor, "product");
   CHECK(xl_machine_tree(&m, &err) == NULL && err);
+  m.identity_screen_only = true;
+  CHECK(xl_machine_tree(&m, &err) == NULL && err);                                 // screen only still needs /product
+  m.identity_screen_only = false;
   xl_adt_free(donor);
 
