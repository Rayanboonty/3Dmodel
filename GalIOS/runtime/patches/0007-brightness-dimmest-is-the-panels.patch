diff --git a/runtime/bridges/brightness/brightness.c b/runtime/bridges/brightness/brightness.c
index 7eb5984..bf774b7 100644
--- a/runtime/bridges/brightness/brightness.c
+++ b/runtime/bridges/brightness/brightness.c
@@ -31,6 +31,8 @@
 
 #define STEP_MS 16u
 #define TOUCH_MAX 4u
+#define BOTTOM_KNEE (BR_BRIGHT_FULL / 10u)    // GalIOS: bottom_remap below this light level
+#define BOTTOM_START (BR_BRIGHT_FULL / 50u)   // GalIOS: the first guess at iOS's dimmest
 #define ALS_STALE_MS 3000u                 // no report for this long: the sensor was turned off under us
 
 // ---- the curve ----------------------------------------------------------------------------------
@@ -121,6 +123,7 @@ struct br_bright {
   uint64_t started_ms;
   uint32_t written;                       // the node's value written last
   uint32_t lit;                           // GalIOS: the last level above 0 (level scale), for the side key's wake
+  uint32_t lin_min;                       // GalIOS: the dimmest light level iOS asked for (BOTTOM_KNEE at most)
   bool lit_linear;
   // touch IC (Samsung's sec input class): its power state follows the display's
   char touch[TOUCH_MAX][200];             // each IC's `enabled` file
@@ -407,6 +410,7 @@ br_bright *br_bright_open(const br_bright_options *options)
     // GalIOS: what the side key's wake brings back before iOS has set a level: One UI's, at least 35 % of the slider.
     b->lit = b->level > BR_BRIGHT_FULL * 35u / 100u ? b->level : BR_BRIGHT_FULL * 35u / 100u;
     b->lit_linear = false;
+    b->lin_min = BOTTOM_START;
     if (pthread_create(&b->panel_thread, NULL, panel_worker, b) == 0) b->info.panel = true;
     else { close(b->fd); b->fd = -1; }
   }
@@ -432,19 +436,35 @@ br_bright *br_bright_open(const br_bright_options *options)
 
 void br_bright_info_get(const br_bright *b, br_bright_info *out) { *out = b->info; }
 
+// GalIOS: iOS's dimmest. CoreBrightness keeps a floor of its own above the min-nits the driver publishes, so its slider's
+// bottom, mapped as a fraction of the light, lit the panel well above One UI's dimmest. The dimmest light level iOS asks
+// for in a session (BOTTOM_START at first; the slider's first trip down teaches the rest) is put on the panel's floor,
+// and the levels between it and BOTTOM_KNEE (10 % of the light) are spread over floor..knee; above the knee nothing
+// changes. Called with b->lock held.
+static uint32_t bottom_remap(br_bright *b, uint32_t level)
+{
+  if (level >= BOTTOM_KNEE) return level;
+  if (level < b->lin_min) b->lin_min = level;
+  uint32_t m = b->lin_min;
+  if (level <= m) return 1;               // the floor (0 is iOS's display off)
+  uint64_t x = (uint64_t)(level - m) * BOTTOM_KNEE / (BOTTOM_KNEE - m);
+  return x ? (uint32_t)x : 1;
+}
+
 void br_bright_set(br_bright *b, uint32_t level, bool linear, uint32_t fade_ms)
 {
   if (!b || !b->info.panel) return;
   if (level > BR_BRIGHT_FULL) level = BR_BRIGHT_FULL;
   if (fade_ms > 10000) fade_ms = 10000;
   pthread_mutex_lock(&b->lock);
+  if (level > 0) { b->lit = level; b->lit_linear = linear; }   // as iOS asked: the side key's wake asks it again
+  if (linear && level > 0) level = bottom_remap(b, level);
   b->from = b->level;
   b->target = level;
   b->linear = linear;
   b->fade_ms = fade_ms;
   b->started_ms = now_ms();
   b->pending = true;
-  if (level > 0) { b->lit = level; b->lit_linear = linear; }
   pthread_cond_signal(&b->wake);
   pthread_mutex_unlock(&b->lock);
 }
diff --git a/runtime/bridges/brightness/test_brightness.c b/runtime/bridges/brightness/test_brightness.c
index 21b6b5e..6db9a29 100644
--- a/runtime/bridges/brightness/test_brightness.c
+++ b/runtime/bridges/brightness/test_brightness.c
@@ -294,6 +294,30 @@ static void test_session(void)
     CHECK(mid > 12750 && mid < 25500);
     usleep(250000);
     CHECK(get(panel, "brightness") == 25500);
+    // GalIOS: iOS's dimmest light level lands on the floor; above 10 % of the light nothing changes.
+    br_bright_set(b, BR_BRIGHT_FULL / 100, true, 0);                // 1 %: below the first guess (2 %), learnt as the dimmest
+    usleep(100000);
+    CHECK(get(panel, "brightness") == 1);
+    br_bright_set(b, BR_BRIGHT_FULL / 50, true, 0);                 // 2 %: just above the floor, below the old map (511)
+    usleep(100000);
+    unsigned low = get(panel, "brightness");
+    CHECK(low > 1 && low < 511);
+    br_bright_set(b, BR_BRIGHT_FULL / 10, true, 0);                 // the knee: as before
+    usleep(100000);
+    CHECK(get(panel, "brightness") == br_bright_map(BR_BRIGHT_FULL / 10, true, 1, 25500));
+    // GalIOS: the side key while iOS's level is 0 brings the last lit level back.
+    br_bright_set(b, BR_BRIGHT_FULL * 3 / 10, true, 0);
+    usleep(100000);
+    unsigned lit = get(panel, "brightness");
+    br_bright_set(b, 0, true, 0);
+    usleep(100000);
+    CHECK(get(panel, "brightness") == 1);
+    br_bright_power_key(b);
+    usleep(900000);
+    CHECK(get(panel, "brightness") == lit);
+    br_bright_power_key(b);                                         // lit: nothing happens
+    usleep(900000);
+    CHECK(get(panel, "brightness") == lit);
     // A fade cut short by the close still leaves One UI's value.
     br_bright_set(b, 0, false, 5000);
     usleep(50000);
