diff --git a/runtime/bridges/audio/backend.c b/runtime/bridges/audio/backend.c
index f24e318..bdb2bf3 100644
--- a/runtime/bridges/audio/backend.c
+++ b/runtime/bridges/audio/backend.c
@@ -34,6 +34,30 @@ static void null_close(void *ctx) { (void)ctx; }
 static const br_audio_backend null_backend = { null_start, null_stop, null_write, null_read, null_close };
 const br_audio_backend *br_audio_null(void **ctx) { *ctx = NULL; return &null_backend; }
 
+// ---- GalIOS: the volume keys' level -------------------------------------------------------------
+// iOS's speaker device publishes no volume control (UniXNU-droidvm's DroidVMAudio.cpp: "controls" is an empty array), so
+// iOS pins its slider at the top and every sound plays at full scale. xnuhost's input passes each volume-key press here as
+// well (it still reaches iOS). The level scales what the helper is sent: 16 steps, the amplitude the square of the step's
+// fraction (even steps to the ear), starting at the top, which is how it played before. Step 16 passes the samples as they are.
+#define GALIOS_STEPS 16u
+static unsigned galios_step = GALIOS_STEPS;
+
+unsigned br_audio_volume_key(int direction)
+{
+  unsigned s = __atomic_load_n(&galios_step, __ATOMIC_RELAXED);
+  if (direction > 0 && s < GALIOS_STEPS) s++;
+  else if (direction < 0 && s > 0) s--;
+  __atomic_store_n(&galios_step, s, __ATOMIC_RELAXED);
+  br_log(1, "audio: GalIOS volume %u of %u (the volume keys)", s, GALIOS_STEPS);
+  return s;
+}
+
+static void galios_scale(int16_t *out, const int16_t *in, unsigned samples, unsigned step)
+{
+  int32_t q = (int32_t)((step * step * 32768u) / (GALIOS_STEPS * GALIOS_STEPS));   // Q15: 32768 at the top
+  for (unsigned k = 0; k < samples; k++) out[k] = (int16_t)(((int32_t)in[k] * q) >> 15);
+}
+
 // ---- the helper ---------------------------------------------------------------------------------
 typedef struct { int fd; pid_t pid; unsigned in_channels; } helper;
 
@@ -68,6 +92,12 @@ static int helper_write(void *ctx, const int16_t *pcm, unsigned frames)
 {
   if (frames > AU_MAX_FRAMES) frames = AU_MAX_FRAMES;
   struct au_header header = { .kind = AU_PCM, .output = 1, .channels = 2, .value = frames };
+  unsigned step = __atomic_load_n(&galios_step, __ATOMIC_RELAXED);
+  if (step < GALIOS_STEPS) {                     // GalIOS: below the top, the volume keys' level
+    int16_t scaled[AU_MAX_FRAMES * 2];
+    galios_scale(scaled, pcm, frames * 2u, step);
+    return send_message(ctx, &header, scaled, frames * 4u) ? 0 : (int)frames;
+  }
   return send_message(ctx, &header, pcm, frames * 4u) ? 0 : (int)frames;
 }
 
