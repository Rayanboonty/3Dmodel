diff --git a/runtime/bridges/brightness/brightness.c b/runtime/bridges/brightness/brightness.c
index f84935c..7eb5984 100644
--- a/runtime/bridges/brightness/brightness.c
+++ b/runtime/bridges/brightness/brightness.c
@@ -120,6 +120,8 @@ struct br_bright {
   uint32_t level;                         // where the fade is now
   uint64_t started_ms;
   uint32_t written;                       // the node's value written last
+  uint32_t lit;                           // GalIOS: the last level above 0 (level scale), for the side key's wake
+  bool lit_linear;
   // touch IC (Samsung's sec input class): its power state follows the display's
   char touch[TOUCH_MAX][200];             // each IC's `enabled` file
   bool touch_on;                          // the worker's, after open
@@ -402,6 +404,9 @@ br_bright *br_bright_open(const br_bright_options *options)
       panel_write(b, b->info.start);
     }
     b->level = b->target = level_of(b->info.start, b->info.floor, b->info.ceiling);
+    // GalIOS: what the side key's wake brings back before iOS has set a level: One UI's, at least 35 % of the slider.
+    b->lit = b->level > BR_BRIGHT_FULL * 35u / 100u ? b->level : BR_BRIGHT_FULL * 35u / 100u;
+    b->lit_linear = false;
     if (pthread_create(&b->panel_thread, NULL, panel_worker, b) == 0) b->info.panel = true;
     else { close(b->fd); b->fd = -1; }
   }
@@ -439,10 +444,46 @@ void br_bright_set(br_bright *b, uint32_t level, bool linear, uint32_t fade_ms)
   b->fade_ms = fade_ms;
   b->started_ms = now_ms();
   b->pending = true;
+  if (level > 0) { b->lit = level; b->lit_linear = linear; }
   pthread_cond_signal(&b->wake);
   pthread_mutex_unlock(&b->lock);
 }
 
+// GalIOS: iOS 27 lights its display again after the side key without a brightness the host can read (CoreBrightness's
+// DisplayBrightness is a float, and IOKit's serialization hands the driver the integer 0: OneiOS docs/newtodo.md 4),
+// so after a lock the panel stayed at its floor, dim, until iOS happened to send brightness-nits. A side-key press
+// while iOS's level is 0 brings the last lit level back 600 ms later, unless iOS has set a level by then.
+static void *power_wake(void *arg)
+{
+  br_bright *b = arg;
+  usleep(600u * 1000u);
+  pthread_mutex_lock(&b->lock);
+  bool dark = !b->stop && b->target == 0;
+  uint32_t lit = b->lit;
+  bool linear = b->lit_linear;
+  pthread_mutex_unlock(&b->lock);
+  if (!dark || !lit) return NULL;
+  br_log(1, "brightness: side key while iOS's level is 0: back to the last lit level %u of %u%s", lit, (unsigned)BR_BRIGHT_FULL,
+         linear ? " (of the light)" : " (of the slider)");
+  br_bright_set(b, lit, linear, 250);
+  return NULL;
+}
+
+void br_bright_power_key(br_bright *b)
+{
+  if (!b || !b->info.panel) return;
+  pthread_mutex_lock(&b->lock);
+  bool dark = b->target == 0;
+  pthread_mutex_unlock(&b->lock);
+  if (!dark) return;
+  pthread_t thread;
+  pthread_attr_t attr;
+  pthread_attr_init(&attr);
+  pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+  if (pthread_create(&thread, &attr, power_wake, b)) br_log(0, "brightness: no thread for the side key's wake");
+  pthread_attr_destroy(&attr);
+}
+
 uint32_t br_bright_current(br_bright *b) { return __atomic_load_n(&b->written, __ATOMIC_RELAXED); }
 
 uint32_t br_bright_level(br_bright *b) { return level_of(br_bright_current(b), b->info.floor, b->info.ceiling); }
