   CHECK(system(command) == 0);
 }
 
+// GalIOS: the bottom remap and the side key's fallback for a kernel without the new driver, then the new driver's
+// slider position and display power, each on a fresh session (a slider position ends the remap for the session).
+static void test_galios(void)
+{
+  char tmp[] = "/tmp/oneios-galios-XXXXXX", panel[300];
+  CHECK(mkdtemp(tmp) != NULL);
+  snprintf(panel, sizeof panel, "%s/panel", tmp);
+  mkdir(panel, 0755);
+  put(panel, "max_brightness", "51000\n"); put(panel, "brightness", "9000\n");
+  br_bright_options o = { .backlight_dir = tmp, .no_als = true };
+  br_bright *b = br_bright_open(&o);
+  CHECK(b != NULL);
+  if (b) {
+    // GalIOS: iOS's range (25 %..100 % of the light with the old driver) is spread over the panel's whole range.
+    br_bright_set(b, 16387, true, 0);                               // the slider's bottom, as the phone sent it
+    usleep(100000);
+    CHECK(get(panel, "brightness") == 1);
+    br_bright_set(b, BR_BRIGHT_FULL, true, 0);                      // its top: the ceiling
+    usleep(100000);
+    CHECK(get(panel, "brightness") == 25500);
+    br_bright_set(b, BR_BRIGHT_FULL * 5 / 8, true, 0);              // halfway between 25 % and 100 %: the panel's middle
+    usleep(100000);
+    unsigned mid = get(panel, "brightness");
+    CHECK(mid > 12500 && mid < 13000);
+    br_bright_set(b, BR_BRIGHT_FULL / 10, true, 0);                 // a lower level later (auto-brightness): the new floor
+    usleep(100000);
+    CHECK(get(panel, "brightness") == 1);
+    br_bright_set(b, BR_BRIGHT_FULL * 5 / 8, true, 0);              // and the rest spread from there: brighter than before
+    usleep(100000);
+    CHECK(get(panel, "brightness") > mid);
+    // GalIOS: without display power from the kernel, a side-key press while the level is 0 brings iOS's level back.
+    br_bright_set(b, BR_BRIGHT_FULL * 3 / 10, true, 0);
+    usleep(100000);
+    unsigned lit = get(panel, "brightness");
+    br_bright_set(b, 0, true, 0);
+    usleep(100000);
+    CHECK(get(panel, "brightness") == 1);
+    br_bright_key(b);
+    usleep(900000);
+    CHECK(get(panel, "brightness") == lit);
+    // GalIOS: a slider position (the new driver) ends the remap: the light levels map as they come again.
+    br_bright_set(b, BR_BRIGHT_FULL / 2, false, 0);
+    usleep(100000);
+    br_bright_set(b, BR_BRIGHT_FULL / 50, true, 0);
+    usleep(100000);
+    CHECK(get(panel, "brightness") == br_bright_map(BR_BRIGHT_FULL / 50, true, 1, 25500));
+    br_bright_set(b, BR_BRIGHT_FULL * 3 / 10, true, 0);
+    usleep(100000);
+    unsigned plain = br_bright_map(BR_BRIGHT_FULL * 3 / 10, true, 1, 25500);
+    CHECK(get(panel, "brightness") == plain && plain > lit);         // no remap: 30 % is brighter than it was
+    // With display power (hosted 0069): the off comes first, the fallback stays out, the on brings the level back.
+    br_bright_display(b, false, "test");
+    usleep(100000);
+    CHECK(get(panel, "brightness") == 1);
+    br_bright_key(b);
+    usleep(900000);
+    CHECK(get(panel, "brightness") == 1);                           // still off: the fallback did not light it
+    br_bright_display(b, true, "test");
+    usleep(100000);
+    CHECK(get(panel, "brightness") == plain);
+    br_bright_close(b);
+  }
+  char command[400];
+  snprintf(command, sizeof command, "rm -rf %s", tmp);
+  CHECK(system(command) == 0);
+}
+
 int main(void)
 {
   test_curve();
@@ -437,6 +504,7 @@ int main(void)
   test_session();
   test_touch();
   test_treble();
+  test_galios();
   printf("brightness: %d checks, %d failures\n", checks, failures);
   return failures ? 1 : 0;
 }
