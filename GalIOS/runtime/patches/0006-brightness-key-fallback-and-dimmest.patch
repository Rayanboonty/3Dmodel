--- a/runtime/bridges/brightness/brightness.c
+++ b/runtime/bridges/brightness/brightness.c
@@ -31,6 +31,8 @@
 
 #define STEP_MS 16u
 #define TOUCH_MAX 4u
+#define BOTTOM_KNEE (BR_BRIGHT_FULL / 10u)    // GalIOS: bottom_remap below this light level
+#define BOTTOM_START (BR_BRIGHT_FULL / 50u)   // GalIOS: the first guess at iOS's dimmest
 enum { TOUCH_NONE = 0, TOUCH_SLEEP = 1, TOUCH_WAKE = 2 };
 #define ALS_STALE_MS 3000u                 // no report for this long: the sensor was turned off under us
 
@@ -130,6 +132,9 @@ struct br_bright {
   bool display_on;                        // iOS's display power, as its framebuffer asked (under lock)
   uint32_t lit_level;                     // the level before the display went off: where it comes back on
   bool lit_linear;
+  uint32_t key_lit;                       // GalIOS: iOS's last level above 0, as asked, for the side key's fallback
+  bool key_lit_linear;
+  uint32_t lin_min;                       // GalIOS: the dimmest light level iOS asked for (BOTTOM_KNEE at most)
   // light sensor
   int als_fd;
   char als_enable[260];
@@ -394,6 +399,8 @@ br_bright *br_bright_open(const br_bright_options *options)
   if (!b) return NULL;
   b->fd = b->als_fd = -1;
   b->display_on = true;                   // iOS draws from its start; its framebuffer says when it turns off
+  b->key_lit = BR_BRIGHT_FULL * 35u / 100u;  // GalIOS: the side key's fallback before iOS set a level
+  b->lin_min = BOTTOM_START;
   b->als_scale = o.als_millilux_per_count ? o.als_millilux_per_count : 1000;
   b->info.max_nits = o.max_nits ? o.max_nits : 500;
   pthread_mutex_init(&b->lock, NULL);
@@ -441,12 +448,29 @@ br_bright *br_bright_open(const br_bright_options *options)
 
 void br_bright_info_get(const br_bright *b, br_bright_info *out) { *out = b->info; }
 
+// GalIOS: iOS's dimmest. CoreBrightness keeps a floor of its own above the min-nits the driver publishes, so the
+// bottom of its range, mapped as a fraction of the light, lit the panel well above One UI's dimmest. The dimmest light
+// level iOS asks for in a session (BOTTOM_START at first; the slider's first trip down teaches the rest) goes on the
+// panel's floor, and the levels up to BOTTOM_KNEE (10 % of the light) are spread from there; above it nothing changes.
+// Called with b->lock held.
+static uint32_t bottom_remap(br_bright *b, uint32_t level)
+{
+  if (level >= BOTTOM_KNEE) return level;
+  if (level < b->lin_min) b->lin_min = level;
+  uint32_t m = b->lin_min;
+  if (level <= m) return 1;               // the floor (0 is no level)
+  uint64_t x = (uint64_t)(level - m) * BOTTOM_KNEE / (BOTTOM_KNEE - m);
+  return x ? (uint32_t)x : 1;
+}
+
 void br_bright_set(br_bright *b, uint32_t level, bool linear, uint32_t fade_ms)
 {
   if (!b || !b->info.panel) return;
   if (level > BR_BRIGHT_FULL) level = BR_BRIGHT_FULL;
   if (fade_ms > 10000) fade_ms = 10000;
   pthread_mutex_lock(&b->lock);
+  if (level > 0) { b->key_lit = level; b->key_lit_linear = linear; }   // as iOS asked: the fallback asks it again
+  if (linear && level > 0) level = bottom_remap(b, level);
   b->from = b->level;
   b->target = level;
   b->linear = linear;
@@ -484,8 +508,41 @@ void br_bright_display(br_bright *b, bool on, const char *why)
          on ? ": the touch IC woken" : b->touch_sleep ? ": the touch IC asleep, the panel at its floor" : ": the panel at its floor (touch-sleep=0)");
 }
 
+// GalIOS: the side key's fallback for a kernel without hosted 0069 (no display power from iOS's framebuffer): iOS 27
+// then lit its display again after the side key with a level the driver read as 0, and the panel stayed at its floor
+// after every lock. A press while iOS's display counts as on and its level is 0 brings iOS's last level back 600 ms
+// later unless iOS has set one. With 0069 the display goes off first (br_bright_display), and this stays out of it.
+static void *key_fallback(void *arg)
+{
+  br_bright *b = arg;
+  usleep(600u * 1000u);
+  pthread_mutex_lock(&b->lock);
+  bool dark = !b->stop && b->display_on && b->target == 0;
+  uint32_t lit = b->key_lit;
+  bool linear = b->key_lit_linear;
+  pthread_mutex_unlock(&b->lock);
+  if (!dark || !lit) return NULL;
+  br_log(1, "brightness: side key while iOS's level is 0 and its display on: back to iOS's last level %u of %u%s", lit,
+         (unsigned)BR_BRIGHT_FULL, linear ? " (of the light)" : " (of the slider)");
+  br_bright_set(b, lit, linear, 250);
+  return NULL;
+}
+
 void br_bright_key(br_bright *b)
 {
+  if (b && b->info.panel) {
+    pthread_mutex_lock(&b->lock);
+    bool dark = b->display_on && b->target == 0;
+    pthread_mutex_unlock(&b->lock);
+    if (dark) {
+      pthread_t thread;
+      pthread_attr_t attr;
+      pthread_attr_init(&attr);
+      pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+      if (pthread_create(&thread, &attr, key_fallback, b)) br_log(0, "brightness: no thread for the side key's fallback");
+      pthread_attr_destroy(&attr);
+    }
+  }
   if (!b || !b->info.touch_nodes) return;
   pthread_mutex_lock(&b->lock);
   b->touch_request = TOUCH_WAKE;            // iOS turns the display on or off next; an off sleeps it again
diff --git a/runtime/bridges/brightness/test_brightness.c b/runtime/bridges/brightness/test_brightness.c
