+// GalIOS 0019: a vCPU refused its cores with EINVAL: they are outside the cpuset Android put this process in (the
+// shell that started the session was in a set without the prime cores), so both prime vCPUs ran on CPU 0 for the
+// whole session. Once, xnuhost moves itself to the root cpuset (every core) and the placement is tried again.
+static bool galios_widen_cpuset(void)
+{
+  static int tried;
+  if (tried) return false;
+  tried = 1;
+  char pid[16];
+  int n = snprintf(pid, sizeof pid, "%d", (int)getpid());
+  static const char *const sets[] = { "/dev/cpuset/cgroup.procs", "/dev/cpuset/top-app/cgroup.procs" };
+  int err = 0;
+  for (unsigned i = 0; i < sizeof sets / sizeof *sets; i++) {
+    int fd = open(sets[i], O_WRONLY | O_CLOEXEC);
+    if (fd < 0) { err = errno; continue; }
+    ssize_t w = write(fd, pid, (size_t)n);
+    err = errno;
+    close(fd);
+    if (w == n) { LOGI("cpu: xnuhost moved to the cpuset %s (every core), so each vCPU can have its own", sets[i]); return true; }
+  }
+  LOGE("cpu: xnuhost could not leave its cpuset (%s): the vCPUs stay where Android lets them", strerror(err));
+  return false;
+}
